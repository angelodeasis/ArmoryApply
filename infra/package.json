{
  "name": "armoryapply-infra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "build:frontend": "npm --prefix ../frontend run build",
    "deploy": "npm run build:frontend && cdk deploy ArmoryApply-Site",
    "deploy:backend": "cdk deploy ArmoryApply-Backend"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1147.0",
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@aws-sdk/s3-presigned-post": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.4",
    "aws-cdk": "^2.1144.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0"
  }
}
